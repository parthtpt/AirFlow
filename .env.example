# ---------------------------------------------------------------------------
# AirFlow environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed. Use strong, unique
# secrets in any non-local environment.
# ---------------------------------------------------------------------------

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-use-a-strong-password
POSTGRES_DB=airflow
# Host port to expose Postgres on (container always listens on 5432).
POSTGRES_PORT=5432

# --- Database URL ---------------------------------------------------------
# Inside docker-compose, services reach Postgres via the service name `postgres`.
# For running the app directly on your host instead, use `localhost`.
DATABASE_URL=postgresql://airflow:change-me-use-a-strong-password@postgres:5432/airflow

# --- Redis ----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Application ----------------------------------------------------------
DAG_FOLDER=backend/dags
LOG_FOLDER=backend/logs

# API server
API_PORT=8000
API_WORKERS=2

# Adminer database UI
ADMINER_PORT=8080
# URL the dashboard links to for the database UI (as seen from your browser).
ADMINER_URL=http://localhost:8080

# Scheduler / worker loop intervals (seconds)
SCHEDULER_INTERVAL=10
WORKER_POLL_INTERVAL=5

# Set to "1" to make container entrypoints wait for Postgres before starting.
WAIT_FOR_DB=1

# ---------------------------------------------------------------------------
# Connections for SSH / rsync operators (used by DAGs).
# Pattern: CONN_<ID>_HOST / _USER / _PORT / _KEY_FILE
# The sample DAG references "prod" and "remote".
# ---------------------------------------------------------------------------
# CONN_PROD_HOST=prod.example.com
# CONN_PROD_USER=deploy
# CONN_PROD_PORT=22
# CONN_PROD_KEY_FILE=/keys/prod_id_rsa

# CONN_REMOTE_HOST=gpu-box.example.com
# CONN_REMOTE_USER=ml
# CONN_REMOTE_KEY_FILE=/keys/remote_id_rsa
